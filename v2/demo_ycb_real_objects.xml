<!--
Real-object simulation scene for the OpenArm course project.

Visual meshes and textures are official YCB object scans (CC BY 4.0), not
procedural stand-ins.  Collision proxies remain simple convex primitives for
stable real-time MuJoCo contact.  See upper_computer/vendor/ycb_official/SOURCE.md.
-->
<mujoco model="openarm bimanual YCB real-object scatter demo">
  <visual>
    <global offwidth="960" offheight="600"/>
    <headlight diffuse="0.75 0.75 0.75" ambient="0.35 0.35 0.35" specular="0.08 0.08 0.08"/>
  </visual>

  <asset>
    <model name="cell" file="cell.xml"/>

    <texture type="2d" name="ycb_bottle_tex"
      file="../upper_computer/vendor/ycb_official/objects/006_mustard_bottle/google_16k/texture_map.png"/>
    <texture type="2d" name="ycb_banana_tex"
      file="../upper_computer/vendor/ycb_official/objects/011_banana/google_16k/texture_map.png"/>
    <texture type="2d" name="ycb_apple_tex"
      file="../upper_computer/vendor/ycb_official/objects/013_apple/google_16k/texture_map.png"/>
    <texture type="2d" name="ycb_mug_tex"
      file="../upper_computer/vendor/ycb_official/objects/025_mug/google_16k/texture_map.png"/>

    <material name="ycb_bottle_mat" texture="ycb_bottle_tex" rgba="1 1 1 1" specular="0.15" shininess="0.2"/>
    <material name="ycb_banana_mat" texture="ycb_banana_tex" rgba="1 1 1 1" specular="0.08" shininess="0.15"/>
    <material name="ycb_apple_mat" texture="ycb_apple_tex" rgba="1 1 1 1" specular="0.12" shininess="0.2"/>
    <material name="ycb_mug_mat" texture="ycb_mug_tex" rgba="1 1 1 1" specular="0.15" shininess="0.25"/>

    <mesh name="ycb_bottle_mesh"
      file="../upper_computer/vendor/ycb_official/objects/006_mustard_bottle/google_16k/textured.obj"
      scale="0.48 0.48 0.48"/>
    <mesh name="ycb_banana_mesh"
      file="../upper_computer/vendor/ycb_official/objects/011_banana/google_16k/textured.obj"
      scale="0.50 0.50 0.50"/>
    <mesh name="ycb_apple_mesh"
      file="../upper_computer/vendor/ycb_official/objects/013_apple/google_16k/textured.obj"
      scale="0.55 0.55 0.55"/>
    <mesh name="ycb_mug_mesh"
      file="../upper_computer/vendor/ycb_official/objects/025_mug/google_16k/textured.obj"
      scale="0.48 0.48 0.48"/>
  </asset>

  <worldbody>
    <attach model="cell" prefix=""/>

    <!-- Angled RGB camera: retains table-plane back-projection while showing
         enough side texture for the official COCO model. -->
    <camera name="vision_overhead" pos="0.75 -0.42 1.38"
      xyaxes="0.885832 0.464007 0 -0.270401 0.516221 0.812650" fovy="38"/>
    <body name="vision_camera_marker" pos="0.75 -0.42 1.38">
      <geom type="box" size="0.035 0.025 0.018" rgba="0.04 0.04 0.04 1" contype="0" conaffinity="0"/>
    </body>

    <body name="ycb_bottle" pos="0.580 0.050 1.006" quat="0.9914 0 0 0.1305">
      <freejoint/>
      <geom name="ycb_bottle_collision" type="box" pos="0 0 0.0450" size="0.0185 0.0185 0.0450"
        mass="0.030" friction="2.0 0.6 0.02" rgba="1 1 1 0.01" contype="1" conaffinity="1"/>
      <geom name="ycb_bottle_visual" type="mesh" mesh="ycb_bottle_mesh" material="ycb_bottle_mat"
        pos="0.00736 0.01128 0.00151" mass="0" contype="0" conaffinity="0"/>
    </body>

    <body name="ycb_banana" pos="0.490 0.030 1.006" quat="0.9659 0 0 0.2588">
      <freejoint/>
      <geom name="ycb_banana_collision" type="box" pos="0 0 0.0120" size="0.0200 0.0200 0.0120"
        mass="0.040" friction="1.5 0.5 0.01" rgba="1 1 1 0.01" contype="1" conaffinity="1"/>
      <geom name="ycb_banana_visual" type="mesh" mesh="ycb_banana_mesh" material="ycb_banana_mat"
        pos="0.00215 -0.00302 0.00020" mass="0" contype="0" conaffinity="0"/>
    </body>

    <body name="ycb_apple" pos="0.550 0.000 1.006">
      <freejoint/>
      <geom name="ycb_apple_collision" type="box" pos="0 0 0.0190" size="0.0190 0.0190 0.0190"
        mass="0.050" friction="1.2 0.4 0.01" rgba="1 1 1 0.01" contype="1" conaffinity="1"/>
      <geom name="ycb_apple_visual" type="mesh" mesh="ycb_apple_mesh" material="ycb_apple_mat"
        pos="-0.00047 0.00208 0.00022" mass="0" contype="0" conaffinity="0"/>
    </body>

    <body name="ycb_cup" pos="0.450 -0.090 1.006" quat="0.9659 0 0 0.2588">
      <freejoint/>
      <geom name="ycb_cup_collision" type="cylinder" pos="0 0 0.0195" size="0.0205 0.0195"
        mass="0.045" friction="1.2 0.4 0.01" rgba="1 1 1 0.01" contype="1" conaffinity="1"/>
      <geom name="ycb_cup_visual" type="mesh" mesh="ycb_mug_mesh" material="ycb_mug_mat"
        pos="0.00425 -0.00832 0.00026" mass="0" contype="0" conaffinity="0"/>
    </body>

    <body name="black_frame" pos="0.47 0.16 1.005">
      <geom name="black_frame_floor" type="box" pos="0 0 0.005" size="0.095 0.085 0.005"
        rgba="0.04 0.04 0.04 1" contype="1" conaffinity="1"/>
      <geom type="box" pos="0.090 0 0.032" size="0.005 0.085 0.032" rgba="0.02 0.02 0.02 1"/>
      <geom type="box" pos="-0.090 0 0.032" size="0.005 0.085 0.032" rgba="0.02 0.02 0.02 1"/>
      <geom type="box" pos="0 0.080 0.032" size="0.085 0.005 0.032" rgba="0.02 0.02 0.02 1"/>
      <geom type="box" pos="0 -0.080 0.032" size="0.085 0.005 0.032" rgba="0.02 0.02 0.02 1"/>
    </body>
  </worldbody>
</mujoco>
